.container {
  min-height: 100vh;
  padding: 0;
  background-color: #f5f5f5;
}

.header {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  padding: 40rpx 30rpx 60rpx;
  color: white;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.username {
  font-size: 32rpx;
  font-weight: 500;
}

.stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background-color: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-number {
  font-size: 48rpx;
  font-weight: bold;
  line-height: 1.2;
}

.completed-number {
  color: #a8ffb8;
}

.pending-number {
  color: #ffe066;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: rgba(255, 255, 255, 0.3);
}

.input-section {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background-color: white;
  margin: -30rpx 30rpx 0;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 10;
}

.todo-input {
  flex: 1;
  font-size: 30rpx;
  padding: 16rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.add-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #07c160 !important;
  color: white !important;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 300;
  padding: 0 !important;
  border: none !important;
  line-height: 1;
}

.add-btn::after {
  border: none !important;
}

.add-btn[disabled] {
  background-color: #ccc !important;
  color: white !important;
}

.filter-tabs {
  display: flex;
  background-color: white;
  margin: 30rpx;
  border-radius: 12rpx;
  padding: 8rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background-color: #07c160;
  color: white;
}

.todo-list {
  padding: 0 30rpx 40rpx;
}

.todo-item {
  display: flex;
  align-items: center;
  background-color: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
}

.todo-item.completed {
  opacity: 0.7;
}

.todo-item.completed .todo-content {
  text-decoration: line-through;
  color: #999;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  transition: all 0.3s;
}

.todo-item.completed .checkbox {
  background-color: #07c160;
  border-color: #07c160;
}

.check-icon {
  color: white;
  font-size: 24rpx;
  font-weight: bold;
}

.todo-content {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  line-height: 1.4;
}

.todo-date {
  font-size: 22rpx;
  color: #999;
  margin-right: 20rpx;
}

.delete-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #ff4d4f;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 36rpx;
  font-weight: 300;
  opacity: 0;
  transition: all 0.3s;
}

.todo-item:hover .delete-btn {
  opacity: 1;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}